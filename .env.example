# =====================================================================
# SpeechAI - Environment Configuration
# Copy this file to .env and fill in your values:
# cp .env.example .env
# =====================================================================

# OpenAI API Key (required for OpenAI TTS, Whisper API, and GPT models)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Base URL (optional - useful for Ollama, LocalAI, vLLM, OpenRouter, Groq, custom proxies)
# Supported variables: OPENAI_BASE_URL, BASE_URL, or OPENAI_API_BASE
# Default: official OpenAI endpoint (leave empty or commented out)
# Examples:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# LLM Model Configuration
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_CHAT_MODEL=gpt-4o-mini

# Speech-to-Text (STT) Configuration
# STT Engine: "openai" (uses Whisper API) or "local" (uses faster-whisper if installed)
STT_ENGINE=openai
OPENAI_WHISPER_MODEL=whisper-1
LOCAL_WHISPER_MODEL=tiny.en

# Text-to-Speech (TTS) Configuration
# TTS Engine: "openai" or "gtts"
TTS_ENGINE=openai
OPENAI_TTS_MODEL=tts-1
# Voices: alloy, echo, fable, onyx, nova, shimmer
OPENAI_TTS_VOICE=nova
GTTS_LANGUAGE=pt
GTTS_TLD=com.br

# Audio Playback & Recording Settings
# Playback Engine: "auto", "pygame", "winsound", or "playsound"
PLAYBACK_ENGINE=auto
AUDIO_SAMPLE_RATE=44100
AUDIO_CHANNELS=1
AUDIO_RECORD_DURATION=5

# Directories and Logging
TEMP_DIR=temp
LOG_LEVEL=INFO
